# 5StratumOS install-time variables for Kraskus Kaspa Solo.
# Filled in by the platform at install time, same as sibling apps
# (kraskus-btc-blake2b-solo, kraskus-chta-solo) — never committed with real
# values, never baked into the image.
#
# Approved, baked directly into the package (not templated):
#   UI port:      33067  (in 5tratstore-app.yml's `port:`, via app_proxy)
#   Stratum port: 1900   (host-facing; bridge remains 5556 internally)
#
# The package bundles its own kaspad — there is no external node network or
# container name to configure here anymore (Command V2's shared node and this
# package are separate deployment models).

# Persistent data root for this app instance (platform-assigned).
# Matches the convention seen in kraskus-btc-blake2b-solo:
#   /var/lib/5tratumos/apps/<app-slug>/...
APP_DATA_DIR=CHANGEME_PLATFORM_ASSIGNED_PATH
